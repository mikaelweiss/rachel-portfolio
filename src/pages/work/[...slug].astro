---
import { type CollectionEntry, getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

import ContactCTA from '../../components/ContactCTA.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import PageGallery from '../../components/PageGallery.astro';
import { render } from 'astro:content';

interface Props {
	entry: CollectionEntry<'work'>;
}

export async function getStaticPaths() {
	const work = await getCollection('work');
	return work.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<div class="stack gap-10">
		<div class="stack gap-4">
			<header>
				<div class="wrapper stack gap-2">
					<a class="back-link" id="back-link" href="/"><Icon icon="arrow-left" /> <span id="back-label">Home</span></a>
					<Hero title={entry.data.title} align="start">
						<div class="details">
							<div class="tags">
								{entry.data.tags.map((t) => <Pill>{t}</Pill>)}
							</div>
							<p class="description">{entry.data.description}</p>
						</div>
					</Hero>
				</div>
			</header>
			<div class="hero-image-container">
				{entry.data.img && (
					<img class="hero-image" src={entry.data.img} alt={entry.data.img_alt || ''} />
				)}
			</div>
			<main class="wrapper">
				<div class="stack gap-10 content">
					{entry.data.pagesDir && entry.data.pageCount && (
						<PageGallery
							pagesDir={entry.data.pagesDir}
							pageCount={entry.data.pageCount}
							alt={entry.data.img_alt || entry.data.title}
						/>
					)}
					<div class="content">
						<Content />
					</div>
				</div>
			</main>
		</div>
		<ContactCTA />
	</div>
</BaseLayout>

<script>
	const link = document.getElementById('back-link') as HTMLAnchorElement;
	const label = document.getElementById('back-label')!;
	const referrer = document.referrer;
	if (referrer && new URL(referrer).pathname.startsWith('/portfolio')) {
		link.href = '/portfolio/';
		label.textContent = 'Portfolio';
	}
</script>

<style>
	header {
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--gray-800);
	}

	.back-link {
		display: none;
	}

	.details {
		display: flex;
		flex-direction: column;
		padding: 0.5rem;
		gap: 0.75rem;
		justify-content: space-between;
		align-items: center;
	}

	.tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.description {
		font-size: var(--text-lg);
		max-width: 54ch;
	}

	.hero-image-container {
		width: 100%;
		padding: 0;
	}

	.hero-image {
		width: 100%;
		max-height: 60vh;
		object-fit: contain;
		display: block;
	}

	.content {
		max-width: 65ch;
		margin-inline: auto;
	}

	.content > :global(* + *) {
		margin-top: 1rem;
	}

	.content :global(h1),
	.content :global(h2),
	.content :global(h3),
	.content :global(h4),
	.content :global(h5) {
		margin: 1.5rem 0;
	}

	.content :global(img) {
		width: 100%;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-sm);
		border: 1px solid var(--gray-800);
	}

	.content :global(.image-row) {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.content :global(.image-row p) {
		margin: 0;
	}

	.content :global(.image-row img) {
		margin-top: 0;
	}

	.content :global(.image-row-3) {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 1rem;
	}

	.content :global(.image-row-3 p) {
		margin: 0;
	}

	.content :global(.image-row-3 img) {
		margin-top: 0;
	}

	.content :global(blockquote) {
		font-size: var(--text-lg);
		font-family: var(--font-brand);
		font-weight: 600;
		line-height: 1.1;
		padding-inline-start: 1.5rem;
		border-inline-start: 0.25rem solid var(--accent-dark);
		color: var(--gray-0);
	}

	.back-link,
	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.back-link:hover,
	.back-link:focus,
	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.back-link {
			display: block;
			align-self: flex-start;
		}

		.details {
			flex-direction: row;
			gap: 2.5rem;
		}

		.content :global(blockquote) {
			font-size: var(--text-2xl);
		}

		.content {
			max-width: 80ch;
		}

		.content :global(.image-row) {
			gap: 1.5rem;
		}

		.content :global(.image-row-3) {
			gap: 1.5rem;
		}
	}
</style>
